{
  "name": "mindigenous",
  "version": "0.1.3",
  "description": "Provider-agnostic agentic coding terminal. One runtime. Any model. Unified capabilities.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mindi": "dist/terminal/index.js",
    "mindigenous": "dist/terminal/index.js",
    "mindi-cli": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "install.ps1",
    "postinstall.cjs",
    "mindigenous-lineart.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faaz345/mindi-runtime.git"
  },
  "homepage": "https://github.com/Faaz345/mindi-runtime#readme",
  "unpkg": "install.ps1",
  "bugs": "https://github.com/Faaz345/mindi-runtime/issues",
  "author": "MOHAMMAD FAAZ SIDDIQUI <faaz.siddiqui345@gmail.com>",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch examples/basic-usage.ts",
    "cli": "tsx src/cli/index.ts",
    "app": "tsx src/terminal/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic-usage.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "postinstall": "node postinstall.cjs",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "agentic",
    "coding-agent",
    "terminal",
    "cli",
    "tui",
    "runtime",
    "augmentation",
    "capabilities",
    "provider-agnostic",
    "openai",
    "gemini"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.17",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  }
}
