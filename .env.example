# MINDI Runtime configuration
# Copy to .env and fill in. Any env var can also be passed directly to the runtime config.

# Primary model provider (the model the USER selected as their reasoning engine)
# This is usually set per-request, but a default can be configured here.
MINDI_DEFAULT_PROVIDER=openai
MINDI_DEFAULT_MODEL=gpt-4o-mini

# OpenAI-compatible provider configuration.
# One adapter supports: OpenAI, OpenRouter, Groq, Together, Fireworks, vLLM, LM Studio, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=

# Google Gemini provider configuration
GEMINI_API_KEY=

# Runtime options
MINDI_LOG_LEVEL=info
MINDI_REQUEST_TIMEOUT_MS=300000
MINDI_TOOL_TIMEOUT_MS=30000
MINDI_MAX_HISTORY_MESSAGES=50
